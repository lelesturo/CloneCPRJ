<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CreaCprjMontante</AssemblyName>
    <RootNamespace>CreaCprjMontante</RootNamespace>
    <Version>4.0.0</Version>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>
    <InformationalVersion>4.0.0-excel-input</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="**\*- Copy.cs" />
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.0" />
  </ItemGroup>
</Project>
